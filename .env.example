# Environment configuration for Repo Analyzer (Session 23)
# Copy to .env and set real values — NEVER commit this file with real values.

# ── Backend ───────────────────────────────────────────────────────────────────

# Database URL (default: SQLite local file)
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/repo_analyzer
DATABASE_URL=sqlite:///repo_analyzer.db

# Cache directory for cloned repositories and analysis cache files
CACHE_DIR=.cache

# ── API Configuration ─────────────────────────────────────────────────────────

# Comma-separated list of allowed CORS origins (default: localhost:3000 dev only)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional API authentication and abuse controls.  API_KEY is server-only.
# Invalid RATE_LIMIT_RPM values use 30; 0 disables rate limiting.
API_KEY=
RATE_LIMIT_RPM=30
TRUST_PROXY_HEADERS=0
MAX_ACTIVE_JOBS=50
JOB_STALE_SECONDS=3600
REPO_MAX_MB=0
CACHE_MAX_AGE_DAYS=
CACHE_MAX_MB=

# ── AI / Embedding Providers (Session 23) ──────────────────────────────────
#
# DEFAULT TEST MODE (offline, deterministic, zero-dependency, CI-safe):
#   LLM_PROVIDER=test
#   EMBEDDING_PROVIDER=test
#
# STEPS TO SWITCH TO REAL AI MODE:
#   1. Install optional dependencies:
#      pip install -r requirements-optional.txt
#   2. Set embedding provider and model:
#      EMBEDDING_PROVIDER=sentence_transformers
#      EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
#   3. Set LLM provider and API key:
#      LLM_PROVIDER=gemini        # or openai
#      GEMINI_API_KEY=your_key_here
#   4. Start backend and check /api/v1/ai/status (must show mode="real").
#   5. Check frontend dashboard badge (must display "AI Mode: Real (...)").
#
# See docs/ai-modes.md for full details.

LLM_PROVIDER=test
EMBEDDING_PROVIDER=test
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ── Frontend ──────────────────────────────────────────────────────────────────

# Backend API URL consumed by Next.js frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
