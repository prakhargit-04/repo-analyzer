# Environment configuration for Repo Analyzer
# Copy to .env and set real values — NEVER commit this file with real values.

# ── Backend ───────────────────────────────────────────────────────────────────

# Database URL (default: SQLite local file)
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/repo_analyzer
DATABASE_URL=sqlite:///repo_analyzer.db

# Cache directory for cloned repositories and analysis cache files
CACHE_DIR=.cache

# ── API Configuration ─────────────────────────────────────────────────────────

# Comma-separated list of allowed CORS origins (default: localhost:3000 dev only)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── AI / Embedding Providers (S23+) ──────────────────────────────────────────
#
# TEST MODE (default, offline, deterministic, CI-safe):
#   LLM_PROVIDER=test           — answers are fixed placeholders, no real AI
#   EMBEDDING_PROVIDER=test     — embeddings are random unit vectors, no real model
#
# REAL MODE (requires network access and API keys):
#   LLM_PROVIDER=gemini         — Google Gemini API
#   GEMINI_API_KEY=your_key_here
#
#   LLM_PROVIDER=openai         — OpenAI API
#   OPENAI_API_KEY=your_key_here
#
#   EMBEDDING_PROVIDER=sentence_transformers  — local sentence-transformers model
#   EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
#
# See docs/TEST_MODE_VS_REAL_MODE.md for full details.

LLM_PROVIDER=test
EMBEDDING_PROVIDER=test
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ── Frontend ──────────────────────────────────────────────────────────────────


# Backend API URL consumed by Next.js frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
